# RepoRevive backend environment. Copy to .env and fill in real values.
# Real secrets must NEVER be committed. This file contains placeholders only.

APP_ENV=development
PORT=8000

# Comma-separated list of allowed browser origins for CORS.
FRONTEND_ORIGIN=http://localhost:5173

# --- AI provider (Gemini) ---------------------------------------------------
# Server-side only. Leave blank to run in deterministic-only mode.
GEMINI_API_KEY=replace_with_server_side_secret
# Pick a model your key supports — list them with the models API.
GEMINI_MODEL=gemini-3.6-flash
EMBEDDING_MODEL=gemini-embedding-001

# Retrieval backend: lexical (default) | embeddings | pgvector | auto.
# embeddings/pgvector need GEMINI_API_KEY; they fall back to lexical if absent.
RETRIEVAL_MODE=lexical

# --- GitHub intake (optional) -----------------------------------------------
# Public repositories only. Raises the unauthenticated rate limit; never used
# to access private repositories. Leave blank to fetch anonymously.
GITHUB_TOKEN=

# --- Optional persistence ---------------------------------------------------
DATABASE_URL=optional_database_connection_string

# --- Safety limits ----------------------------------------------------------
MAX_ARCHIVE_BYTES=10485760      # 10 MB compressed upload
MAX_EXTRACTED_BYTES=52428800    # 50 MB extracted total
MAX_ANALYZED_FILES=1000
MAX_FILE_BYTES=262144           # 256 KB per text file
MAX_AI_FILES=100                # distinct files whose content may reach the AI
MAX_AI_CONTEXT_CHARS=8000       # hard cap on retrieved context per AI call
MAX_STORED_ANALYSES=100

# --- Rate limiting (per-client, on POST endpoints; GET polling is exempt) ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_ANALYSIS_START_MAX=10   # analyze + upload, per window
RATE_LIMIT_CHAT_MAX=30             # chat questions, per window
TRUSTED_PROXY_HOPS=0               # set to 1 behind a single proxy (e.g. Render)
